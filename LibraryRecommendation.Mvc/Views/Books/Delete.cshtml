@model BookViewModel
@{
    ViewData["Title"] = $"Delete {Model.Title}";
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Books</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></li>
        <li class="breadcrumb-item active" aria-current="page">Delete</li>
    </ol>
</nav>

<h1 class="h2 mb-3">Delete book</h1>

<div class="alert alert-warning">
    Are you sure you want to delete this book? This cannot be undone.
</div>

<div class="card mb-3">
    <div class="card-body">
        <h2 class="card-title h4">@Model.Title</h2>
        <h3 class="card-subtitle h6 text-muted mb-3">@Model.Author</h3>

        <p>
            <span class="badge text-bg-primary">@Model.Category</span>
            <span class="badge text-bg-secondary">@Model.Genre</span>
            <span class="badge text-bg-light">Rating @Model.Rating.ToString("0.0") / 5</span>
            <span class="badge text-bg-light">Published @Model.PublishedYear</span>
        </p>

        <p class="card-text">@Model.Description</p>
    </div>
</div>

<form asp-action="Delete" asp-route-id="@Model.Id" method="post">
    @Html.AntiForgeryToken()
    <button type="submit" class="btn btn-danger">Delete this book</button>
    <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Cancel</a>
</form>
