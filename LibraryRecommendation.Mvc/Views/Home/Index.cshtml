@model HomeViewModel
@{
    ViewData["Title"] = "Home";
}

<div class="p-4 p-md-5 mb-4 bg-light rounded-3">
    <h1 class="display-5 fw-bold">AI Library Book Recommendation System</h1>
    <p class="lead mb-4">
        Pick any book and this catalogue suggests others like it, ranking every title by TF-IDF
        and cosine similarity over the book descriptions &mdash; written from scratch in C# with
        no external machine-learning libraries.
    </p>
    <a asp-controller="Books" asp-action="Index" class="btn btn-primary btn-lg">Browse All Books</a>
</div>

<div class="row row-cols-1 row-cols-sm-2 g-3 mb-5">
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <p class="display-4 fw-bold mb-0">@Model.TotalBooks</p>
                <p class="text-muted mb-0">Books in the catalogue</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 text-center">
            <div class="card-body">
                <p class="display-4 fw-bold mb-0">@Model.GenreCount</p>
                <p class="text-muted mb-0">Genres covered</p>
            </div>
        </div>
    </div>
</div>

<p class="text-muted">
    The catalogue is split into two independent collections. Recommendations never cross between
    them &mdash; each category is scored against its own corpus.
</p>

@foreach (var category in Model.Categories)
{
    <section class="mb-5">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2 class="h4 mb-0">
                @category.Name
                <span class="badge text-bg-primary align-middle">@category.BookCount</span>
            </h2>
            @if (category.BookCount > 0)
            {
                <a asp-controller="Books"
                   asp-action="Index"
                   asp-route-category="@category.Name"
                   class="btn btn-sm btn-outline-primary">Browse @category.Name</a>
            }
        </div>

        @if (!category.Genres.Any())
        {
            <div class="alert alert-secondary mb-0">
                No @category.Name.ToLowerInvariant() books have been added yet.
            </div>
        }
        else
        {
            <div class="d-flex flex-wrap gap-2">
                @foreach (var genre in category.Genres)
                {
                    <a asp-controller="Books"
                       asp-action="FilterByGenre"
                       asp-route-genre="@genre.Name"
                       asp-route-category="@category.Name"
                       class="btn btn-outline-secondary btn-sm">
                        @genre.Name
                        <span class="badge text-bg-secondary ms-1">@genre.BookCount</span>
                    </a>
                }
            </div>
        }
    </section>
}

<section>
    <h2 class="h4 mb-3">Most recently published</h2>
    @if (!Model.FeaturedBooks.Any())
    {
        <div class="alert alert-info">No books to show.</div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-3">
            @foreach (var book in Model.FeaturedBooks)
            {
                <div class="col">
                    <div class="card h-100">
                        <div class="card-body d-flex flex-column">
                            <h3 class="card-title h6">
                                <a asp-controller="Books" asp-action="Details" asp-route-id="@book.Id">@book.Title</a>
                            </h3>
                            <h4 class="card-subtitle h6 text-muted mb-2">@book.Author</h4>
                            <p class="mb-0 mt-auto">
                                <span class="badge text-bg-primary">@book.Category</span>
                                <span class="badge text-bg-secondary">@book.Genre</span>
                                <span class="badge text-bg-light">@book.PublishedYear</span>
                                @if (book.Rating > 0)
                                {
                                    <span class="badge text-bg-success">@book.Rating.ToString("0.0") / 5</span>
                                }
                            </p>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</section>
